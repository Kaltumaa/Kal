# Copy to .env (git ignores .env) and fill in. No quotes, no spaces around =. Restart `make run` after editing.
# Leave a line empty to keep that feature off.

# DeepLeaf Agronomist: Auth-issued ORGANISATION key, starts with feed_the_world_, needs the agronomist scope.
# Server only; never put it in a browser or the frontend.
DEEPLEAF_API_KEY=
# Optional: only if DeepLeaf gave you a different API host
# DEEPLEAF_BASE_URL=https://api.deepleaf.org/v1/agronomist
DEEPLEAF_ID_SALT=change-me-to-any-random-text

# Africa's Talking voice. All five set = real calls; otherwise calls are simulated.
AT_USERNAME=
AT_API_KEY=
AT_VOICE_NUMBER=
# Your ngrok https URL for port 8001, no trailing slash, e.g. https://mkulima.ngrok-free.app
VOICE_PUBLIC_URL=
# Any long random secret: openssl rand -hex 16
VOICE_WEBHOOK_TOKEN=
AT_SAY_VOICE=woman

# Internal carrier simulator (used when the Africa's Talking settings above are empty)
# VOICE_AUTO_SIMULATE=1       1 = simulated calls are answered automatically (default in make run); 0 = use the buttons
# VOICE_SIM_DIGIT=random      the key the simulated farmer presses: 1, 2, 0, none or random

# --- Accounts (JWT) ------------------------------------------------------------------------------------------------
# Signs login tokens. Any long random secret: openssl rand -hex 32. Empty = a new secret each start (everyone is
# signed out on restart).
JWT_SECRET=
# JWT_TTL_MINUTES=720

# Public https URL that reaches this API (ngrok for port 8000), no trailing slash. Used for payment callbacks.
PUBLIC_BASE_URL=

# --- Live weather ----------------------------------------------------------------------------------------------------
# Open-Meteo is the primary source and needs no key. 0 = no network: the cached ward baseline is used and flagged.
CROP_PILOT_LIVE_WEATHER=1
# Visual Crossing (secondary source, used to cross-verify Open-Meteo before any spray advice). Free key at
# visualcrossing.com. Empty = Open-Meteo only (advice is marked "single source, not cross-verified").
VISUAL_CROSSING_API_KEY=
# CROP_PILOT_WEATHER_TIMEOUT=6

# --- M-Pesa Daraja (STK Push) ----------------------------------------------------------------------------------------
# All four set = real calls to Daraja; otherwise the built-in simulator answers (no money moves).
# Sandbox test credentials: developer.safaricom.co.ke (sandbox paybill 174379 and its passkey).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Where Daraja posts the result. Empty = PUBLIC_BASE_URL + /api/payments/mpesa/callback
MPESA_CALLBACK_URL=
# Shared secret added to the callback URL (?t=...); Daraja does not sign callbacks. Required for real payments.
MPESA_CALLBACK_TOKEN=
# 1 = always use the simulator, even with keys set (offline demos, judging)
MPESA_SIMULATE=

# --- Card payments (Visa / Mastercard) ---------------------------------------------------------------------------------
# stripe or flutterwave. Only TEST keys are used unless PAYMENTS_ALLOW_LIVE=1. No key = simulator.
CARD_PROVIDER=stripe
# Stripe: sk_test_... and the endpoint secret (whsec_...) for /api/payments/card/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Flutterwave: FLWSECK_TEST-... and the secret hash you set in the dashboard (sent as the verif-hash header)
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
# Where the payer lands after checkout. Empty = this API's /api/payments/card/return
CARD_SUCCESS_URL=
CARD_CANCEL_URL=
CARD_SIMULATE=
PAYMENTS_ALLOW_LIVE=

# --- WhatsApp (Meta WhatsApp Cloud API) -------------------------------------------------------------------------------
# Empty token = simulated: messages are stored and shown under Sent messages -> WhatsApp, nothing leaves the laptop.
# From developers.facebook.com -> your app -> WhatsApp -> API setup.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; type the same one in Meta's webhook settings. Webhook URL: https://<ngrok>/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=
# App secret (App settings -> Basic): verifies that inbound webhooks really come from Meta.
WHATSAPP_APP_SECRET=
# Approved message template with one body parameter, for advice sent outside the 24-hour reply window.
WHATSAPP_TEMPLATE=
# WHATSAPP_TEMPLATE_LANG=en
