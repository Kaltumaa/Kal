# Copy to .env (git ignores .env) and fill in. No quotes, no spaces around =. Restart `make run` after editing.
# Leave a line empty to keep that feature off.

# DeepLeaf Agronomist: Auth-issued ORGANISATION key, starts with feed_the_world_, needs the agronomist scope.
# Server only; never put it in a browser or the frontend.
DEEPLEAF_API_KEY=
# Optional: only if DeepLeaf gave you a different API host
# DEEPLEAF_BASE_URL=https://api.deepleaf.org/v1/agronomist
DEEPLEAF_ID_SALT=change-me-to-any-random-text

# Africa's Talking voice. All five set = real calls; otherwise calls are simulated.
AT_USERNAME=
AT_API_KEY=
AT_VOICE_NUMBER=
# Your ngrok https URL for port 8001, no trailing slash, e.g. https://mkulima.ngrok-free.app
VOICE_PUBLIC_URL=
# Any long random secret: openssl rand -hex 16
VOICE_WEBHOOK_TOKEN=
AT_SAY_VOICE=woman

# Internal carrier simulator (used when the Africa's Talking settings above are empty)
# VOICE_AUTO_SIMULATE=1       1 = simulated calls are answered automatically (default in make run); 0 = use the buttons
# VOICE_SIM_DIGIT=random      the key the simulated farmer presses: 1, 2, 0, none or random
