// TALO in GitHub Codespaces: the Control Desk, the API, the webhooks and the local AI models, free on a
// 4-core / 16 GB codespace. Open: repo → Code → Codespaces → Create codespace. Guide: .devcontainer/README.md
{
  "name": "TALO",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },

  // Once, when the codespace is built: Python packages and Ollama (pinned to the version we test with).
  "postCreateCommand": "bash .devcontainer/setup.sh",
  // Every time it starts: TALO and the models, in the background. Log: /tmp/talo.log
  "postStartCommand": "setsid nohup bash .devcontainer/start.sh > /tmp/talo.log 2>&1 < /dev/null &",

  "forwardPorts": [8501, 8001],
  "portsAttributes": {
    "8501": { "label": "TALO Control Desk", "onAutoForward": "openBrowser" },
    "8001": { "label": "Webhooks (WhatsApp, voice)", "onAutoForward": "silent" },
    "8000": { "label": "API (keep private)", "onAutoForward": "ignore" },
    "11434": { "label": "Ollama (keep private)", "onAutoForward": "ignore" }
  },
  "customizations": {
    "codespaces": { "openFiles": [".devcontainer/README.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
